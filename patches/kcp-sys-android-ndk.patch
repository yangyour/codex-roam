+fn android_ndk_clang_args(target: &str) -> Vec<String> {
+    if !target.contains("-android") {
+        return Vec::new();
+    }
+
+    let Some(ndk_root) = ["ANDROID_NDK_HOME", "ANDROID_NDK_ROOT", "NDK_HOME"]
+        .into_iter()
+        .find_map(|key| env::var_os(key).map(PathBuf::from))
+    else {
+        return Vec::new();
+    };
+
+    let prebuilt_root = ndk_root.join("toolchains/llvm/prebuilt");
+    let Some(prebuilt) = std::fs::read_dir(&prebuilt_root)
+        .ok()
+        .and_then(|entries| {
+            entries
+                .filter_map(Result::ok)
+                .map(|entry| entry.path())
+                .find(|path| path.is_dir())
+        })
+    else {
+        return Vec::new();
+    };
+
+    let clang_root = prebuilt.join("lib/clang");
+    let builtin_include = std::fs::read_dir(&clang_root)
+        .ok()
+        .and_then(|entries| {
+            entries
+                .filter_map(Result::ok)
+                .map(|entry| entry.path())
+                .filter(|path| path.is_dir())
+                .max()
+        })
+        .map(|path| path.join("include"));
+
+    let mut args = vec![format!(
+        "--sysroot={}",
+        prebuilt.join("sysroot").to_string_lossy()
+    )];
+    if let Some(include) = builtin_include.filter(|path| path.is_dir()) {
+        args.push("-isystem".to_owned());
+        args.push(include.to_string_lossy().into_owned());
+    }
+    args
+}
